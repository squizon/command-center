# ===== Microsoft Outlook (Graph API) =====
# Register an app at https://portal.azure.com > App registrations
# Set redirect URI to: http://localhost:3000/auth/outlook/callback
# API Permissions needed: Mail.Read, Mail.Send, Calendars.Read, User.Read
OUTLOOK_CLIENT_ID=your-client-id-here
OUTLOOK_CLIENT_SECRET=your-client-secret-here
OUTLOOK_TENANT_ID=your-tenant-id-here

# ===== Slack =====
# Create an app at https://api.slack.com/apps
# Set redirect URI to: http://localhost:3000/auth/slack/callback
# Bot Token Scopes needed: channels:history, im:history, users:read, chat:write
SLACK_CLIENT_ID=your-slack-client-id
SLACK_CLIENT_SECRET=your-slack-client-secret
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_USER_TOKEN=xoxp-your-user-token

# ===== Server =====
PORT=3000
